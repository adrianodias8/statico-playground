+++ b/src/bin/wasm.rs
@@ -0,0 +1,25 @@
+//! Statico for the browser playground (WASI): builds the site in the given
+//! directory into `<dir>/_site` and prints the build report as JSON. The
+//! optional second argument is the site's URL, so a preview served under a
+//! sub-path gets its links prefixed. There is nothing to download here, so
+//! Tailwind and esbuild are skipped and assets are copied as they are.
+fn main() {
+    let mut args = std::env::args().skip(1);
+    let root = std::path::PathBuf::from(args.next().unwrap_or_else(|| "/site".into()));
+    let opts = statico::build::BuildOptions {
+        url: args.next(),
+        out: None,
+        skip_tools: true,
+        minify: Some(false),
+        hash_assets: Some(false),
+    };
+    match statico::build::build(&root, opts) {
+        // The report, plus which source file made each page (the CLI's
+        // report leaves that out).
+        Ok(report) => println!("{}", serde_json::json!({ "report": &report, "pages": &report.page_info })),
+        Err(e) => {
+            eprintln!("{e:#}");
+            std::process::exit(1);
+        }
+    }
+}
